rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /incidents/{incidentId} {
      function signedIn() { return request.auth != null; }
      function owner() { return signedIn() && resource.data.ownerUid == request.auth.uid; }
      function caregiver() {
        return signedIn() && 'caregiverUids' in resource.data &&
          request.auth.uid in resource.data.caregiverUids;
      }
      function active() {
        return resource.data.expiresAt is timestamp && request.time < resource.data.expiresAt;
      }
      // A high-entropy incident link is a time-limited read capability. No enumeration.
      // Missing documents remain observable while the phone creates the incident.
      allow get: if resource == null || owner() || caregiver() || active();
      allow list: if false;
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['incidentId', 'ownerUid', 'status', 'createdAt', 'expiresAt', 'userName']) &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.incidentId == incidentId &&
        request.resource.data.status == 'ACTIVE' &&
        request.resource.data.userName is string &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.expiresAt > request.time &&
        request.resource.data.expiresAt <= request.time + duration.value(4, 'h');
      allow update: if active() && (
        (owner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'latitude', 'longitude', 'accuracy', 'lastUpdate', 'source', 'status', 'endedAt',
          'aiSummary', 'audioTranscript', 'threatLevel', 'aiAnalyzedAt'
        ]) && request.resource.data.status in ['ACTIVE', 'ACKNOWLEDGED', 'COMPLETED'] &&
          (resource.data.status != 'COMPLETED' || request.resource.data.status == 'COMPLETED')) ||
        (caregiver() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'claimedBy', 'claimedEta', 'claimedNote', 'claimedAt', 'caregiverStatus',
          'reassurancePing', 'status', 'resolvedAt', 'resolutionNote'
        ]) && (request.resource.data.status == resource.data.status || request.resource.data.status == 'COMPLETED'))
      );
      allow delete: if false;
      // Enrollment and legacy response processing are trusted-server operations only.
      match /responses/{responseId} { allow read, write: if false; }
    }
  }
}
